{
  "manifest_version": 2,
  "name": "Slitherify",
  "version": "1.0",

  "description": "Adds a red border to all webpages matching mozilla.org.",

  "icons": {
    "48": "icons/border-48.png"
  },

  "content_scripts": [
    {
      "matches": ["http://slither.com/io"],
      "js": [
        "dist/content.js"
        ]
    }
  ]
}