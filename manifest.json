{
  "manifest_version": 2,
  "name": "Slitherator",
  "version": "1.0",

  "description": "Useful Utilities for slither.io",

  "icons": {
    "48": "icons/slitherator-48.jpg"
  },

  "permissions": ["activeTab"],

  "browser_action": {
    "default_icon": "icons/slitherator.jpg",
    "default_title": "Slitherator",
    "default_popup": "popup/slitherator.html"
  },
  "content_scripts": [
    {
      "matches": ["http://slither.com/io"],
      "js": [
        "dist/browser-polyfill.js",
        "dist/content.js"
        ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@slitherator",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "web_accessible_resources": [
    "icons/player.png"
  ]


}