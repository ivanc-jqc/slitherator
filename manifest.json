{
  "manifest_version": 2,
  "name": "Slitherator",
  "version": "1.0",

  "description": "Useful Utilities for slither.io",

  "icons": {
    "48": "icons/slitherator.png"
  },

  "permissions": ["activeTab"],

  "browser_action": {
    "default_icon": "icons/slitherator.png",
    "default_title": "Slitherator",
    "default_popup": "popup/slitherator.html"
  },

  "content_scripts": [
    {
      "matches": ["http://slither.com/io"],
      "js": [
        "dist/content.js"
        ]
    }
  ],

  "web_accessible_resources": [
    "icons/player.png"
  ]


}